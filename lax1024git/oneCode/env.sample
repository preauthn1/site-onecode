; 应用调试模式
APP_DEBUG = true

; 应用Trace
APP_TRACE = false

; 自动创建多语言不存在的文字
AUTO_LANG = false

; 网站url
WEB_URL = 

; 资源url
STATIC_URL = 

; 分享二维码链接类型1 注册地址，2下载地址
SHARE_TYPE = 2

; 时区
;TIMEZONE = PRC

; 首页模板主题
;INDEX_THEME = default

; 代理IP字段 使用cloudflare.com代理时打开
;HTTP_AGENT_IP = HTTP_CF_CONNECTING_IP

; 宝塔API
BT_KEY = 
BT_PANEL = 
BT_SITE_ID = 
BT_WEB_NAME = 
BT_AUTH_USER = admin
BT_AUTH_PWD = 
SERVER_ADDR = 

[DATABASE]
; 服务器地址
HOSTNAME = 127.0.0.1
; 数据库名
DATABASE = qd_lywl_cc_demo
; 用户名
USERNAME = root
; 密码
PASSWORD = 123456
; 端口
HOSTPORT = 3306
; 数据库表前缀
PREFIX = qd_
; 分布式 1为开启
DEPLOY = 0
; 读写分离
RW_SEPARATE = false
; 读写分离后主数据库的数量
MASTER_NUM = 1
; 从数据库的序号
SLAVE_NO = ''

[REDIS]
; 服务器地址
HOST = 127.0.0.1
; 端口
PORT = 6379
; 密码
PASSWORD = 

[QUEUE]
; 服务器地址
HOST = 127.0.0.1
; 端口
PORT = 6379
; DB
SELECT = 1
; 密码
PASSWORD =


; AWS S3存储
[S3]
CREDENTIALS_KEY = 
CREDENTIALS_SECRET = 
BUCKET = 
REGION = ap-southeast-1 